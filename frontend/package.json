{
  "name": "training-company-frontend",
  "version": "1.0.0",
  "description": "Training Company Management Application Frontend - React.js client for managing Torn City training companies",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "vite build",
    "lint": "eslint . --ext js,jsx --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview",
    "start": "npm run dev",
    "build:production": "NODE_ENV=production vite build",
    "serve": "vite preview --host",
    "clean": "rm -rf dist node_modules/.vite",
    "type-check": "echo 'Type checking not configured (using JSDoc instead of TypeScript)'",
    "format": "prettier --write 'src/**/*.{js,jsx,css,md}'"
  },
  "dependencies": {
    "axios": "^1.6.5",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.21.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.31.0",
    "@types/react": "^18.2.48",
    "@types/react-dom": "^18.2.18",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.16",
    "eslint": "^9.31.0",
    "eslint-plugin-react": "^7.33.2",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.5",
    "postcss": "^8.4.33",
    "tailwindcss": "^3.4.1",
    "vite": "^7.0.4"
  },
  "keywords": [
    "react",
    "vite",
    "training-management",
    "torn-city",
    "dashboard",
    "admin-panel"
  ],
  "author": "Training Company Development Team",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "private-repository"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  }
}
