# Training Company App - Comprehensive .gitignore
# Covers both backend and frontend development

# Dependencies
node_modules/
/.pnp
.pnp.js
jspm_packages/

# Environment variables
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env.production
.env.staging

# Database files
*.db
*.db-journal
*.sqlite
*.sqlite3

# Prisma
prisma/migrations/
prisma/dev.db*

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*

# Runtime data
pids/
*.pid
*.seed
*.pid.lock

# Coverage directory used by tools like istanbul
coverage/
*.lcov

# Testing
/coverage

# Production builds
/build
/dist
build/
dist/

# Optional npm cache directory
.npm

# Optional eslint cache
.eslintcache

# Optional REPL history
.node_repl_history

# Output of 'npm pack'
*.tgz

# Yarn Integrity file
.yarn-integrity

# Parcel-bundler cache (https://parceljs.org/)
.cache
.parcel-cache

# Next.js build output
.next
out/

# Nuxt.js build / generate output
.nuxt
.nuxt-generate

# Gatsby files
.cache/
public/

# Vuepress build output
.vuepress/dist

# Vite cache
.vite/

# Serverless directories
.serverless/

# FuseBox cache
.fusebox/

# DynamoDB Local files
.dynamodb/

# TernJS port file
.tern-port

# Stores VSCode versions used for testing VSCode extensions
.vscode-test

# IDE files
.vscode/
.idea/
*.swp
*.swo
*~

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Temporary folders
tmp/
temp/

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Backup files
*.backup
*.bak
*.tmp

# Archives
*.7z
*.dmg
*.gz
*.iso
*.jar
*.rar
*.tar
*.zip

# Local development
.env.development
.env.test

# PM2 ecosystem files
ecosystem.config.js

# Docker
Dockerfile.local
docker-compose.override.yml

# Security
*.pem
*.key
*.cert
*.crt