{
  "name": "training-company-app",
  "version": "1.0.0",
  "description": "Training Company Management Dashboard",
  "scripts": {
    "start": "cd backend && npx prisma migrate deploy && npx prisma generate && node src/server.js",
    "build": "npm run install:backend && npm run install:frontend && npm run build:frontend",
    "install:backend": "cd backend && npm ci --omit=dev",
    "install:frontend": "cd frontend && npm ci",
    "build:frontend": "cd frontend && npm run build",
    "dev:backend": "cd backend && npm run dev",
    "dev:frontend": "cd frontend && npm run dev"
  },
  "engines": {
    "node": "20.x",
    "npm": "10.x"
  },
  "main": "backend/src/server.js"
}
